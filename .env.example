# ============================================================================
# ESRS Regulation Bot - Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in your actual credentials
# NEVER commit the .env file to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# OpenAI Configuration
# ----------------------------------------------------------------------------
# Your OpenAI API key for embeddings and LLM operations
OPENAI_API_KEY=your_openai_api_key_here

# Embedding model for vector search (default: text-embedding-3-large)
EMBEDDING_MODEL=text-embedding-3-large

# LLM model for generation tasks (default: gpt-5.2)
LLM_MODEL=gpt-5.2

# ----------------------------------------------------------------------------
# Azure Document Intelligence
# ----------------------------------------------------------------------------
# Azure Document Intelligence endpoint URL
# Format: https://your-resource-name.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/

# Azure Document Intelligence API key
AZURE_DOCUMENT_INTELLIGENCE=your_azure_document_intelligence_key_here

# ----------------------------------------------------------------------------
# Azure Blob Storage
# ----------------------------------------------------------------------------
# Azure Storage connection string for blob storage
# Format: DefaultEndpointsProtocol=https;AccountName=xxx;AccountKey=xxx;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account_name;AccountKey=your_account_key;EndpointSuffix=core.windows.net
