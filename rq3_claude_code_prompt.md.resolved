# Extract gold and predicted labels, filtering to successful parses only
scored = [r for r in results if r.success and normalize_label(r.predicted)]
gold = [normalize_label(r.gold_fulfillment_level) for r in scored]
pred = [normalize_label(r.predicted_fulfillment_level) for r in scored]

print(f"Scored samples: {len(scored)} / {len(results)}")
print(f"Gold label distribution: {Counter(gold)}")
```

